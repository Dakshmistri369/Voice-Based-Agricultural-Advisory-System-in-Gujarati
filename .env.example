# =============================================================
# Voice-Based Agricultural Advisory System — Environment Config
# =============================================================
# Copy this file to .env and fill in your values

# ---- Hugging Face API Tokens ----
# Token 1: Used for STT (Whisper) + TTS (MMS) calls
HF_TOKEN_VOICE=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token 2: Used for LLM (Llama 3.2 3B) calls
HF_TOKEN_LLM=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Supabase (Optional — system works without this using JSON files) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---- App Settings ----
# Host and port for FastAPI server
APP_HOST=0.0.0.0
APP_PORT=8000

# Default location for weather (Rajkot, Gujarat center)
DEFAULT_LAT=22.3039
DEFAULT_LON=70.8022
DEFAULT_CITY=Rajkot

# Enable/disable features (true/false)
USE_SUPABASE=false
USE_HF_VOICE=true
USE_HF_LLM=true

# CORS origins (comma-separated, * = allow all for dev)
CORS_ORIGINS=*
